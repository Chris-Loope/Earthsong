---
import SubscribeForm from "@/components/SubscribeForm.astro";
import "@/styles/global.css";

const {
  title = "Earthsong",
  description = "A living philosophy of nature, spirit, and community.",
  image = "/og.png",
  fullWidth = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const canonical = new URL(currentPath, Astro.site ?? Astro.url.origin);
const socialImage = image ? new URL(image, Astro.site ?? Astro.url.origin) : null;
const navLinks = [
  { href: "/codex", label: "Codex" },
  { href: "/calendar", label: "Cycles" },
  { href: "/elders", label: "Elders" },
  { href: "/newsletter", label: "Letters" },
  { href: "/from-dominion-to-harmony", label: "Stewardship" },
];
---
<!doctype html>
<html lang="en" class="bg-chalk text-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1a2e1a" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Earthsong" />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body class="min-h-screen bg-chalk font-body text-ink antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header
      class:list={[
        "inset-x-0 top-0 z-50 border-b border-mist/15 text-chalk",
        isHome
          ? "absolute bg-gradient-to-b from-ink/75 to-transparent"
          : "sticky bg-ink/95 shadow-field backdrop-blur-md",
      ]}
    >
      <div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-5 sm:px-6 lg:px-8">
        <a href="/" class="group inline-flex items-center gap-3" aria-label="Earthsong home">
          <span class="relative flex h-8 w-8 items-center justify-center rounded-full border border-mist/40">
            <span class="h-2.5 w-2.5 rounded-full bg-ember transition-transform duration-300 group-hover:scale-125"></span>
          </span>
          <span class="font-display text-2xl uppercase tracking-[0.14em] text-chalk">Earthsong</span>
        </a>

        <nav aria-label="Main navigation" class="hidden items-center gap-7 md:flex">
          {navLinks.map((link) => {
            const active = currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "border-b py-2 font-mono text-[10px] font-semibold uppercase tracking-[0.17em] transition-colors",
                  active
                    ? "border-ember text-chalk"
                    : "border-transparent text-mist/75 hover:border-mist/30 hover:text-chalk",
                ]}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <button
          id="menu-toggle"
          type="button"
          class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-md border border-mist/20 text-chalk md:hidden"
          aria-label="Toggle navigation"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-200"></span>
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-200"></span>
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-200"></span>
        </button>
      </div>

      <nav
        id="mobile-menu"
        aria-label="Mobile navigation"
        class="absolute inset-x-0 top-full hidden border-y border-mist/15 bg-ink/98 px-5 py-5 shadow-field backdrop-blur-lg md:hidden"
      >
        <div class="mx-auto grid max-w-6xl gap-1">
          {navLinks.map((link, index) => {
            const active = currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex min-h-12 items-center justify-between border-b border-mist/10 py-3 font-display text-2xl uppercase tracking-[0.08em]",
                  active ? "text-ember" : "text-chalk",
                ]}
              >
                <span>{link.label}</span>
                <span class="font-mono text-[10px] text-mist/65">0{index + 1}</span>
              </a>
            );
          })}
        </div>
      </nav>
    </header>

    {fullWidth ? (
      <main id="main-content" class="min-h-[60vh]">
        <slot />
      </main>
    ) : (
      <main id="main-content" class="mx-auto min-h-[60vh] w-full max-w-5xl px-5 py-12 sm:px-6 md:py-16 lg:px-8">
        <slot />
      </main>
    )}

    <footer class="border-t border-mist/10 bg-ink text-chalk">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-14 sm:px-6 md:grid-cols-[1.1fr_.7fr_1.2fr] lg:px-8 lg:py-16">
        <div>
          <a href="/" class="inline-flex items-center gap-3" aria-label="Earthsong home">
            <span class="h-2.5 w-2.5 rounded-full bg-ember"></span>
            <span class="font-display text-4xl uppercase tracking-[0.1em]">Earthsong</span>
          </a>
          <p class="mt-4 max-w-sm font-body text-sm leading-relaxed text-mist/70">
            A living philosophy for walking gently, listening deeply, and remembering our place within the living world.
          </p>
        </div>

        <div>
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-light">Explore</p>
          <nav aria-label="Footer navigation" class="mt-4 grid gap-2">
            {navLinks.slice(0, 4).map((link) => (
              <a href={link.href} class="w-fit text-sm text-mist/75 transition-colors hover:text-chalk">
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        <div>
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-light">Stay in the song</p>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-mist/70">
            Seasonal letters at the solstices and equinoxes. No noise—just a few considered notes each year.
          </p>
          <div class="mt-5 max-w-md">
            <SubscribeForm compact />
          </div>
        </div>
      </div>
      <div class="border-t border-mist/10">
        <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 font-mono text-[10px] uppercase tracking-[0.16em] text-mist/65 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <span>Walk gently. © {new Date().getFullYear()} Earthsong.</span>
          <span>Nature · Spirit · Community</span>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');

      function setMenu(open: boolean) {
        if (!toggle || !menu) return;
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        const bars = toggle.querySelectorAll('.hamburger-bar');
        bars[0]?.classList.toggle('translate-y-[7px]', open);
        bars[0]?.classList.toggle('rotate-45', open);
        bars[1]?.classList.toggle('opacity-0', open);
        bars[2]?.classList.toggle('-translate-y-[7px]', open);
        bars[2]?.classList.toggle('-rotate-45', open);
      }

      toggle?.addEventListener('click', () => {
        setMenu(toggle.getAttribute('aria-expanded') !== 'true');
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenu(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          toggle.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (
          toggle?.getAttribute('aria-expanded') === 'true' &&
          event.target instanceof Node &&
          !toggle.contains(event.target) &&
          !menu?.contains(event.target)
        ) {
          setMenu(false);
        }
      });
    </script>
  </body>
</html>
