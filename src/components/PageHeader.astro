---
const {
  eyebrow,
  title,
  description,
  align = "left",
} = Astro.props;
---

<header class:list={[
  "border-b border-ink/15 pb-8 md:pb-10",
  align === "center" && "text-center",
]}>
  <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-ember-dark">
    {eyebrow}
  </p>
  <h1 class="mt-3 font-display text-5xl uppercase leading-[0.92] tracking-[0.055em] text-ink sm:text-6xl md:text-7xl">
    {title}
  </h1>
  {description && (
    <p class:list={[
      "mt-5 max-w-3xl font-body text-base leading-relaxed text-stone md:text-lg",
      align === "center" && "mx-auto",
    ]}>
      {description}
    </p>
  )}
</header>
