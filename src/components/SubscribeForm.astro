---
const { compact = false } = Astro.props;
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION;
const configured = Boolean(newsletterAction);
const inputId = compact ? "subscribe-email-footer" : "subscribe-email-page";
---

{configured ? (
  <form
    class="subscribe-form"
    name="newsletter"
    method="POST"
    action={newsletterAction}
  >
    {compact ? (
      <div class="flex flex-col gap-2 sm:flex-row">
        <label for={inputId} class="sr-only">Email address</label>
        <input
          id={inputId}
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="your@email.com"
          class="min-h-11 min-w-0 flex-1 rounded-md border border-mist/20 bg-white/5 px-3 py-2 font-body text-sm text-chalk placeholder:text-mist/40 focus:border-ember focus:outline-none"
        />
        <button
          type="submit"
          class="min-h-11 rounded-md bg-ember-dark px-5 py-2 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-chalk transition-colors hover:bg-ember-deep"
        >
          Subscribe
        </button>
      </div>
    ) : (
      <div class="rounded-lg border border-moss/20 bg-white/65 p-6 shadow-field sm:p-8">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">Seasonal letters</p>
        <h2 class="mt-3 font-display text-4xl uppercase tracking-[0.05em] text-ink">Stay in the Song</h2>
        <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-stone">
          Seasonal knowledge, a mindful individual practice, and one positive thought to carry forward.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <label for={inputId} class="sr-only">Email address</label>
          <input
            id={inputId}
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="min-h-12 flex-1 rounded-md border border-ink/20 bg-chalk px-4 py-2.5 font-body text-sm text-ink placeholder:text-stone focus:border-ember-dark focus:outline-none"
          />
          <button
            type="submit"
            class="min-h-12 rounded-md bg-ember-dark px-6 py-2.5 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-chalk transition-colors hover:bg-ember-deep"
          >
            Join the letter
          </button>
        </div>
      </div>
    )}
  </form>
) : compact ? (
  <a
    href="/newsletter"
    class="inline-flex min-h-11 items-center rounded-md border border-mist/20 px-4 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-chalk transition-colors hover:border-ember-light hover:text-ember-light"
  >
    Read the seasonal letters →
  </a>
) : (
  <div class="rounded-lg border border-moss/20 bg-white/65 p-6 shadow-field sm:p-8">
    <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">Seasonal letters</p>
    <h2 class="mt-3 font-display text-4xl uppercase tracking-[0.05em] text-ink">How to read them</h2>
    <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-stone">
      Learn one interesting thing, try one mindful individual practice, and carry one useful idea into the season ahead.
    </p>
  </div>
)}
