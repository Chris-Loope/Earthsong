---
const href = "https://chatgpt.com/g/g-67313328cc4c8190a6becc5419cf4c4b-the-voice-of-earthsong";
---

<section class="relative overflow-hidden rounded-lg bg-forest px-6 py-10 text-chalk shadow-field sm:px-10 md:py-14">
  <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full border border-mist/10"></div>
  <div class="pointer-events-none absolute -right-8 -top-12 h-52 w-52 rounded-full border border-ember/30"></div>
  <div class="pointer-events-none absolute right-10 top-8 h-20 w-20 rounded-full bg-ember/15 blur-xl"></div>

  <div class="relative max-w-2xl">
    <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-light">A conversational companion</p>
    <h2 class="mt-3 font-display text-4xl uppercase leading-none tracking-[0.05em] sm:text-5xl">
      Ask the Earthsong Guide
    </h2>
    <p class="mt-4 max-w-xl font-body text-base leading-relaxed text-mist/75">
      Explore the Codex, Sacred Cycles, the Elders, and Earthsong’s philosophy through an open conversation.
    </p>
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-7 inline-flex min-h-12 items-center rounded-md bg-ember-dark px-6 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-chalk transition-all hover:-translate-y-0.5 hover:bg-ember-deep focus-visible:outline-chalk"
    >
      Open the Guide <span aria-hidden="true" class="ml-3">↗</span>
    </a>
    <p class="mt-3 font-mono text-[9px] uppercase tracking-[0.12em] text-mist/65">
      Opens in a new tab on ChatGPT
    </p>
  </div>
</section>
