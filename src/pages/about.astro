---
import Layout from '@/components/Layout.astro';

const principles = [
  {
    num: '01',
    title: 'Nature as context',
    body: 'Natural systems provide context for questions about timing, care, limits, resilience, and interdependence.',
  },
  {
    num: '02',
    title: 'Inquiry as method',
    body: 'Earthsong asks useful questions, compares perspectives, and tests ideas without requiring agreement.',
  },
  {
    num: '03',
    title: 'Facts held firmly',
    body: 'Scientific claims should be sourced and corrected when evidence changes. Observation comes before interpretation.',
  },
  {
    num: '04',
    title: 'Metaphors held lightly',
    body: 'Stories and symbols can help us think, but they are not universal truths, supernatural instructions, or borrowed authority.',
  },
];
---

<Layout
  title="About Earthsong — A Thought and Tools Experiment"
  description="Earthsong is a thought experiment and a technology-and-tools experiment grounded in nature, observation, and inquiry."
  fullWidth
>
  <section class="relative overflow-hidden bg-forest text-chalk">
    <div class="absolute inset-0 bg-[url('/leaf-texture.jpg')] bg-cover bg-center opacity-10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/75 via-forest/80 to-forest/35"></div>
    <div class="pointer-events-none absolute -right-24 -top-28 h-[30rem] w-[30rem] rounded-full border border-mist/10"></div>
    <div class="pointer-events-none absolute right-10 top-10 h-64 w-64 rounded-full border border-ember/25"></div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-28 lg:px-8">
      <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.24em] text-ember-light">A thought and tools experiment</p>
      <h1 class="mt-5 max-w-5xl font-display text-[clamp(4.5rem,13vw,9rem)] uppercase leading-[0.82] tracking-[0.055em]">
        About<br /> Earthsong
      </h1>
      <p class="mt-7 max-w-3xl font-body text-xl italic leading-relaxed text-mist/85 md:text-2xl">
        Nature as context. Inquiry as method.
      </p>
    </div>
  </section>

  <section class="border-b border-ink/10 bg-chalk">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-6 md:grid-cols-[.7fr_1.3fr] md:py-24 lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">The experiment</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-[0.94] tracking-[0.05em] text-ink sm:text-6xl">Ideas for living with greater attention.</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-[1.85] text-stone md:text-lg">
        <p>
          Earthsong is a thought experiment about how people might live, decide, and build with greater attention to the natural systems that sustain them.
        </p>
        <p>
          It is also a technology-and-tools experiment: a working space for using digital tools to research, organize, test, and publish ideas. The tools support the inquiry; they do not replace observation, evidence, or human judgment.
        </p>
        <p>
          The site brings together a sky calendar grounded in observable cycles, a developing codex, and seasonal letters that connect broad questions to ordinary practice. It is an invitation to explore and reflect (<a href="/disclaimer#philosophy-not-religion" class="text-ember-dark underline decoration-1 underline-offset-2 hover:text-ember-deep">read what it isn't</a>).
        </p>
      </div>
    </div>
  </section>

  <section class="bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-3xl">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">Working principles</p>
        <h2 class="mt-3 font-display text-5xl uppercase tracking-[0.05em] text-ink sm:text-6xl">Observe carefully. Explore openly.</h2>
        <p class="mt-5 font-body text-base leading-[1.85] text-stone md:text-lg">
          Earthsong treats attention as a practical discipline. Its ideas are offered as prompts for observation, conversation, and considered action.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4">
        {principles.map((principle) => (
          <article class="border-b border-ink/15 py-8 md:border-r md:px-6 md:first:pl-0 lg:border-b-0 lg:last:border-r-0 lg:last:pr-0">
            <span class="font-mono text-[9px] font-bold tracking-[0.13em] text-ember-dark">{principle.num}</span>
            <h3 class="mt-6 font-display text-3xl uppercase tracking-[0.05em] text-ink">{principle.title}</h3>
            <p class="mt-3 font-body text-sm leading-[1.75] text-stone">{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink text-chalk">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-6 md:grid-cols-2 md:py-24 lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-light">How to use Earthsong</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-none tracking-[0.05em]">Explore, test, carry forward</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-[1.85] text-mist/75">
        <p>
          Use the sky calendar to follow observable cycles, the Codex to explore ideas, and the seasonal letters to bring those ideas into everyday life.
        </p>
        <p>
          Take what sharpens attention or encourages thoughtful action. Question what does not. The experiment lives in what can be observed, tested, and put to constructive use.
        </p>
      </div>
    </div>
  </section>

  <section class="texture-paper">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-16 sm:px-6 md:flex-row md:items-center md:justify-between md:py-20 lg:px-8">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-dark">Where to begin</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-none tracking-[0.05em] text-ink">Read it as an experiment</h2>
        <p class="mt-4 font-body text-base leading-relaxed text-stone">Start with the Codex for the current thinking, or a seasonal letter for one idea you can take into ordinary life.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/codex" class="inline-flex min-h-12 items-center justify-center rounded-md bg-ember-dark px-6 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-chalk transition-colors hover:bg-ember-deep">Read the Codex</a>
        <a href="/newsletter" class="inline-flex min-h-12 items-center justify-center rounded-md border border-ink/25 px-6 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-ink transition-colors hover:border-ember-dark hover:text-ember-dark">Read the letters</a>
      </div>
    </div>
  </section>
</Layout>
