---
import Layout from "@/components/Layout.astro";

export async function getStaticPaths() {
  const issues = await import.meta.glob("../../content/newsletter/*.mdx", { eager: true }) as Record<string, any>;
  return Object.entries(issues).map(([path, mod]) => ({
    params: { slug: path.split("/").pop()!.replace(/\.mdx$/, "") },
    props: {
      title: mod.frontmatter.title,
      issue: mod.frontmatter.issue,
      date: mod.frontmatter.date,
      summary: mod.frontmatter.summary,
      Content: mod.default,
    },
  }));
}

const { title, issue, date, summary, Content } = Astro.props;
const published = new Date(date);
const allIssues = await import.meta.glob("../../content/newsletter/*.mdx", { eager: true }) as Record<string, any>;
const sorted = Object.entries(allIssues)
  .map(([path, mod]) => ({
    slug: path.split("/").pop()!.replace(/\.mdx$/, ""),
    issue: mod.frontmatter.issue as number,
    title: mod.frontmatter.title as string,
  }))
  .sort((a, b) => a.issue - b.issue);

const currentIndex = sorted.findIndex((entry) => entry.issue === issue);
const previous = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<Layout title={`${title} — Earthsong Seasonal Letters`} description={summary}>
  <nav aria-label="Breadcrumb" class="font-mono text-[9px] uppercase tracking-[0.13em] text-stone">
    <a href="/newsletter" class="transition-colors hover:text-ember-dark">Seasonal letters</a>
    <span aria-hidden="true" class="mx-2 text-ink/25">/</span>
    <span>Issue #{String(issue).padStart(3, "0")}</span>
  </nav>

  <header class="mt-8 border-b border-ink/15 pb-9">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em] text-ember-dark">
      <span>Issue #{String(issue).padStart(3, "0")}</span>
      <span aria-hidden="true" class="h-1 w-1 rounded-full bg-ink/30"></span>
      <time datetime={published.toISOString().slice(0, 10)} class="text-stone">
        {published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </time>
    </div>
    <h1 class="mt-5 max-w-4xl font-display text-6xl uppercase leading-[0.9] tracking-[0.05em] text-ink sm:text-7xl md:text-8xl">{title}</h1>
    {summary && <p class="mt-6 max-w-3xl font-body text-base italic leading-relaxed text-stone md:text-lg">{summary}</p>}
  </header>

  <article class="letter-prose prose prose-lg mx-auto mt-12 max-w-3xl prose-earthsong">
    <Content />
  </article>

  <nav aria-label="Seasonal letter navigation" class="mt-16 grid gap-px overflow-hidden rounded-lg bg-ink/15 sm:grid-cols-2">
    {previous ? (
      <a href={`/newsletter/${previous.slug}`} class="group bg-chalk p-5 transition-colors hover:bg-white/70">
        <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-stone">← Previous letter</span>
        <span class="mt-2 block font-display text-2xl uppercase tracking-[0.05em] text-ink group-hover:text-ember-dark">{previous.title}</span>
      </a>
    ) : <span class="hidden bg-chalk sm:block" />}
    {next ? (
      <a href={`/newsletter/${next.slug}`} class="group bg-chalk p-5 text-right transition-colors hover:bg-white/70">
        <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-stone">Next letter →</span>
        <span class="mt-2 block font-display text-2xl uppercase tracking-[0.05em] text-ink group-hover:text-ember-dark">{next.title}</span>
      </a>
    ) : <span class="hidden bg-chalk sm:block" />}
  </nav>

  <div class="mt-12 rounded-lg border border-moss/20 bg-white/65 p-6 shadow-field sm:p-8">
    <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">Seasonal letters</p>
    <h2 class="mt-3 font-display text-4xl uppercase tracking-[0.05em] text-ink">How to read them</h2>
    <p class="mt-2 max-w-2xl font-body text-sm leading-relaxed text-stone">
      Learn one interesting thing, try one mindful individual practice, and carry one useful idea into the season ahead.
    </p>
  </div>
</Layout>
