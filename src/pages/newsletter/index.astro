---
import Layout from "@/components/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SubscribeForm from "@/components/SubscribeForm.astro";

const issueModules = import.meta.glob("../../content/newsletter/*.mdx", { eager: true }) as Record<string, any>;
const sorted = Object.entries(issueModules)
  .map(([path, mod]) => ({
    title: mod.frontmatter.title as string,
    issueNum: mod.frontmatter.issue as number,
    date: new Date(mod.frontmatter.date),
    summary: mod.frontmatter.summary as string,
    slug: path.split("/").pop()!.replace(/\.mdx$/, ""),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout title="Seasonal Letters — Earthsong" description="Solstice and equinox letters connecting seasonal knowledge from the past with mindful action in the present and care for the future.">
  <PageHeader
    eyebrow="Published at the thresholds"
    title="Seasonal Letters"
    description="Each solstice and equinox, look back at what the turning has meant, notice what it means now, and carry one useful practice into what comes next."
  />

  <p class="mt-6 max-w-3xl font-mono text-[9px] uppercase leading-relaxed tracking-[0.1em] text-stone">
    Seasonal names follow Northern Hemisphere convention. The astronomical event is global; north and south experience opposite seasons.
  </p>

  <div class="mt-10">
    <SubscribeForm />
  </div>

  <section class="mt-14">
    <div class="flex items-end justify-between border-b border-ink/15 pb-5">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">The archive</p>
        <h2 class="mt-2 font-display text-4xl uppercase tracking-[0.055em] text-ink">All letters</h2>
      </div>
      <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-stone">{sorted.length} issues</span>
    </div>

    <div class="grid gap-px overflow-hidden border-b border-ink/15 bg-ink/15 md:grid-cols-2">
      {sorted.map((issue, index) => (
        <a
          href={`/newsletter/${issue.slug}`}
          class:list={[
            "group bg-chalk p-6 transition-colors hover:bg-white/70 sm:p-8",
            index === 0 && "md:col-span-2 md:grid md:grid-cols-[160px_1fr] md:gap-8",
          ]}
        >
          <div>
            <span class="font-display text-5xl leading-none tracking-[0.05em] text-ember-dark">#{String(issue.issueNum).padStart(3, "0")}</span>
            <time datetime={issue.date.toISOString().slice(0, 10)} class="mt-2 block font-mono text-[9px] uppercase tracking-[0.1em] text-stone">
              {issue.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
          </div>
          <div class:list={[index === 0 ? "mt-6 md:mt-0" : "mt-6"]}>
            <h3 class:list={[
              "font-display uppercase leading-none tracking-[0.05em] text-ink transition-colors group-hover:text-ember-dark",
              index === 0 ? "text-5xl" : "text-4xl",
            ]}>
              {issue.title}
            </h3>
            {issue.summary && <p class="mt-4 font-body text-sm leading-[1.75] text-stone">{issue.summary}</p>}
            <span class="mt-6 inline-flex font-mono text-[9px] font-bold uppercase tracking-[0.12em] text-ink">
              Read the letter <span aria-hidden="true" class="ml-3 text-ember transition-transform group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    {sorted.length === 0 && <p class="py-10 font-body text-sm text-stone">No letters have been published yet.</p>}
  </section>
</Layout>
