---
import Layout from '@/components/Layout.astro';

const principles = [
  {
    num: '01',
    title: 'Attention',
    body: 'Notice the actual place: its watershed, seasons, species, histories, limits, and the people whose knowledge is rooted there.',
  },
  {
    num: '02',
    title: 'Proportion',
    body: 'Match the scale of a choice to the scale of its effects. Enough can be a better measure than more.',
  },
  {
    num: '03',
    title: 'Reciprocity',
    body: 'Make visible what a household, project, or community receives from a place, then ask what care should travel in return.',
  },
  {
    num: '04',
    title: 'Repair',
    body: 'When harm is known, begin with what can genuinely be mended, maintained, restored, or prevented from happening again.',
  },
];

const practices = [
  {
    num: '01',
    title: 'Learn one place',
    body: 'Name your watershed and one species that lives nearby. Learn what each needs, what pressures it faces, and who is already doing credible work there.',
  },
  {
    num: '02',
    title: 'Follow one flow',
    body: 'Trace one ordinary resource—water, electricity, food, or waste—from source to use to aftermath. Let the full path inform one choice.',
  },
  {
    num: '03',
    title: 'Keep something useful',
    body: 'Maintain, mend, refill, share, or buy used before replacing. Repair is not a complete environmental strategy, but it is a practical habit of attention.',
  },
  {
    num: '04',
    title: 'Support work already underway',
    body: 'Look for local groups with knowledge, consent, and a record of care. Listen before helping, and contribute in the form they say is useful.',
  },
];

const questions = [
  'What changed in the living world around me this season?',
  'What did I learn that corrected an assumption?',
  'Which choice created more care, and which only felt symbolic?',
  'What is one useful practice worth carrying into the next season?',
];
---

<Layout
  title="From Dominion to Harmony — Earthsong"
  description="A public thought experiment about treating the living world as a participant in human choices rather than scenery around them."
  fullWidth
>
  <section class="relative overflow-hidden bg-forest text-chalk">
    <div class="absolute inset-0 bg-[url('/leaf-texture.jpg')] bg-cover bg-center opacity-10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-forest/80 to-forest/30"></div>
    <div class="pointer-events-none absolute -right-24 -top-32 h-[32rem] w-[32rem] rounded-full border border-mist/10"></div>
    <div class="pointer-events-none absolute right-8 top-4 h-72 w-72 rounded-full border border-ember/25"></div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-28 lg:px-8">
      <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.24em] text-ember-light">A public thought experiment</p>
      <h1 class="mt-5 max-w-5xl font-display text-[clamp(4.25rem,10vw,8.5rem)] uppercase leading-[0.82] tracking-[0.055em]">
        From Dominion<br /> to Harmony
      </h1>
      <p class="mt-7 max-w-3xl font-body text-lg leading-relaxed text-mist/80 md:text-xl">
        What changes when the natural world is treated as a participant in our choices rather than scenery around them?
      </p>
      <nav aria-label="On this page" class="mt-9 flex flex-wrap gap-2">
        <a href="#question" class="inline-flex min-h-11 items-center rounded-full border border-mist/25 px-4 font-mono text-[9px] font-bold uppercase tracking-[0.12em] transition-colors hover:border-ember-light hover:text-ember-light">The question</a>
        <a href="#principles" class="inline-flex min-h-11 items-center rounded-full border border-mist/25 px-4 font-mono text-[9px] font-bold uppercase tracking-[0.12em] transition-colors hover:border-ember-light hover:text-ember-light">Four lenses</a>
        <a href="#practice" class="inline-flex min-h-11 items-center rounded-full border border-mist/25 px-4 font-mono text-[9px] font-bold uppercase tracking-[0.12em] transition-colors hover:border-ember-light hover:text-ember-light">Individual practice</a>
        <a href="#seasonal-check-in" class="inline-flex min-h-11 items-center rounded-full border border-mist/25 px-4 font-mono text-[9px] font-bold uppercase tracking-[0.12em] transition-colors hover:border-ember-light hover:text-ember-light">Seasonal check-in</a>
      </nav>
    </div>
  </section>

  <section id="question" class="scroll-mt-24 border-b border-ink/10 bg-chalk">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-6 md:grid-cols-[.7fr_1.3fr] md:py-24 lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">A change of posture</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-[0.94] tracking-[0.05em] text-ink sm:text-6xl">Not master of a backdrop, but participant in a system.</h2>
      </div>
      <div class="space-y-5 font-body text-base leading-[1.85] text-stone md:text-lg">
        <p>
          Dominion treats land, water, other species, and often other people chiefly as resources for a human plan. Harmony does not mean that every need aligns or that nature is always gentle. It asks for a more honest account of relationship: human life depends on systems we influence but do not control.
        </p>
        <p>
          This is not a proposal to give a river a mystical voice or pretend that a forest can consent like a person. It is a decision-making prompt. Who understands this place? What lives here? What limits are observable? Who receives the benefit, who carries the cost, and what remains after us?
        </p>
        <p>
          Earthsong began asking these questions while imagining governance for a possible sustainable village. They are just as useful at the scale of one household, one purchase, or one afternoon outside.
        </p>
      </div>
    </div>
  </section>

  <section id="principles" class="scroll-mt-24 bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-24 lg:px-8">
      <div class="border-b border-ink/15 pb-6">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">Four useful lenses</p>
        <h2 class="mt-3 font-display text-5xl uppercase tracking-[0.05em] text-ink">Questions before rules</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4">
        {principles.map((principle) => (
          <article class="border-b border-ink/15 py-8 md:border-r md:px-6 md:first:pl-0 lg:border-b-0 lg:last:border-r-0 lg:last:pr-0">
            <span class="font-mono text-[9px] font-bold tracking-[0.13em] text-ember-dark">{principle.num}</span>
            <h3 class="mt-6 font-display text-3xl uppercase tracking-[0.05em] text-ink">{principle.title}</h3>
            <p class="mt-3 font-body text-sm leading-[1.75] text-stone">{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink text-chalk">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-6 md:grid-cols-[.8fr_1.2fr] md:py-20 lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-light">A boundary worth keeping</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-none tracking-[0.05em]">No doctrine required</h2>
      </div>
      <div class="space-y-4 font-body text-base leading-[1.8] text-mist/75">
        <p>
          Harmony is a working hypothesis. No one needs Earthsong language to care well for a place, and symbolic action should not be confused with measurable improvement (<a href="/disclaimer#philosophy-not-religion" class="text-ember-light underline decoration-1 underline-offset-2 hover:text-chalk">read what it isn't</a>).
        </p>
        <p>
          The idea earns its keep only when it helps someone learn more accurately, choose more carefully, or repair something that matters. When better evidence or experience appears, the idea should change.
        </p>
      </div>
    </div>
  </section>

  <section id="practice" class="scroll-mt-24 bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-3xl">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">At an individual scale</p>
        <h2 class="mt-3 font-display text-5xl uppercase tracking-[0.05em] text-ink sm:text-6xl">Four places to begin</h2>
        <p class="mt-4 font-body text-base leading-relaxed text-stone">These are possibilities, not assignments. One attentive, repeatable action is more useful than a dramatic promise that disappears.</p>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden rounded-lg bg-ink/15 md:grid-cols-2">
        {practices.map((practice) => (
          <article class="bg-white/65 p-6 sm:p-8">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-4xl uppercase tracking-[0.05em] text-ink">{practice.title}</h3>
              <span class="font-mono text-[9px] font-bold tracking-[0.13em] text-ember-dark">{practice.num}</span>
            </div>
            <p class="mt-5 font-body text-sm leading-[1.8] text-stone">{practice.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="seasonal-check-in" class="scroll-mt-24 texture-paper border-t border-ink/10">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-6 lg:grid-cols-[.7fr_1.3fr] lg:px-8 lg:py-24">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-ember-dark">A rhythm for revision</p>
        <h2 class="mt-3 font-display text-5xl uppercase tracking-[0.05em] text-ink sm:text-6xl">Check in with the season</h2>
        <p class="mt-4 font-body text-sm leading-relaxed text-stone">Solstices and equinoxes offer four memorable moments each year to notice what changed and adjust what comes next.</p>
      </div>
      <ol class="border-t border-ink/15">
        {questions.map((question, index) => (
          <li class="grid grid-cols-[44px_1fr] gap-4 border-b border-ink/15 py-5">
            <span class="font-mono text-[9px] font-bold tracking-[0.13em] text-ember-dark">0{index + 1}</span>
            <span class="font-body text-base leading-relaxed text-ink">{question}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-ink/10 bg-chalk">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-16 sm:px-6 md:flex-row md:items-center md:justify-between md:py-20 lg:px-8">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-dark">Continue the thought</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-none tracking-[0.05em] text-ink">Observe, reflect, revise</h2>
        <p class="mt-4 font-body text-base leading-relaxed text-stone">The Codex develops the philosophy; the letters connect it to particular thresholds in the turning year.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/codex" class="inline-flex min-h-12 items-center justify-center rounded-md bg-ember-dark px-6 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-chalk transition-colors hover:bg-ember-deep">Read the Codex</a>
        <a href="/newsletter" class="inline-flex min-h-12 items-center justify-center rounded-md border border-ink/25 px-6 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-ink transition-colors hover:border-ember-dark hover:text-ember-dark">Read the letters</a>
      </div>
    </div>
  </section>
</Layout>
