---
import { Image } from 'astro:assets';
import Layout from '@/components/Layout.astro';
import heroImage from '@/assets/earthsong-hero.jpg';

const paths = [
  {
    num: '01',
    title: 'The Codex',
    description: 'Six chapters tracing a living philosophy of origin, ethical learning, symbols, place, compassion, and observable cycles.',
    href: '/codex',
    label: 'Begin with the First Note',
  },
  {
    num: '02',
    title: 'Sky & Season',
    description: 'Follow new moons, full moons, solstices, equinoxes, and eclipses through the turning years.',
    href: '/calendar',
    label: 'Follow the turning sky',
  },
  {
    num: '03',
    title: 'From Dominion to Harmony',
    description: 'Consider what changes when the living world is treated as a participant in our choices rather than scenery around them.',
    href: '/from-dominion-to-harmony',
    label: 'Explore the thought experiment',
  },
];
---

<Layout title="Earthsong — Nature, Community, and Possibility" fullWidth>
  <section class="relative flex min-h-[88svh] items-end overflow-hidden bg-ink text-chalk">
    <Image
      src={heroImage}
      alt="Sunrise behind a mountain reflected in a forest lake"
      widths={[640, 1024, 1536, 2048]}
      sizes="100vw"
      quality={86}
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_55%_50%,transparent_0%,rgba(15,15,13,.18)_42%,rgba(15,15,13,.72)_100%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink/85 via-forest/45 to-ink/15"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-transparent to-ink/20"></div>

    <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-36 sm:px-6 md:pb-20 lg:px-8 lg:pb-24">
      <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.24em] text-ember-light sm:text-xs">
        A living thought experiment · Nature, community, possibility
      </p>
      <h1 class="mt-5 max-w-5xl font-display text-[clamp(3.75rem,21vw,10.5rem)] uppercase leading-[0.76] tracking-[0.06em] text-chalk sm:tracking-[0.075em]">
        Earthsong
      </h1>
      <p class="mt-7 max-w-2xl font-body text-xl italic leading-relaxed text-chalk/85 md:text-2xl">
        Earnest about nature. Light about ourselves.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="/codex"
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-ember-dark px-6 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-chalk transition-all hover:-translate-y-0.5 hover:bg-ember-deep"
        >
          Explore the Codex
        </a>
        <a
          href="/calendar"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-mist/35 bg-ink/20 px-6 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-chalk backdrop-blur-sm transition-colors hover:border-chalk hover:bg-ink/40"
        >
          Follow Sky & Season
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-ink/10 bg-chalk">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-6 md:grid-cols-[.8fr_1.2fr] md:py-24 lg:px-8">
      <div>
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-dark">The experiment</p>
        <h2 class="mt-4 font-display text-5xl uppercase leading-[0.94] tracking-[0.055em] text-ink sm:text-6xl">
          What if we planned with the living world in mind?
        </h2>
      </div>
      <div class="md:pt-8">
        <p class="font-body text-lg leading-[1.85] text-stone">
          Earthsong began with a practical question: how might people make decisions with greater care for the places and living systems that sustain them? That question widened into an exploration of governance, natural cycles, compassion, and repair. This site is one evolving answer (<a href="/disclaimer#philosophy-not-religion" class="text-ember-dark underline decoration-1 underline-offset-2 hover:text-ember-deep">read what it isn't</a>).
        </p>
        <a href="/about" class="mt-7 inline-flex items-center border-b border-ember/40 pb-1 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-ember-dark transition-colors hover:border-ember-dark">
          Read how Earthsong began <span aria-hidden="true" class="ml-3">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-chalk">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-6 md:py-24 lg:px-8">
      <div class="flex flex-col gap-4 border-b border-ink/15 pb-7 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-dark">Three ways in</p>
          <h2 class="mt-3 font-display text-5xl uppercase tracking-[0.055em] text-ink">Begin listening</h2>
        </div>
        <p class="max-w-md font-body text-sm leading-relaxed text-stone">Enter through philosophy, observation, or a practical question. Keep what proves useful; revise what does not.</p>
      </div>

      <div class="grid md:grid-cols-3">
        {paths.map((path) => (
          <a href={path.href} class="group relative border-b border-ink/15 py-9 md:border-b-0 md:border-r md:px-7 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
            <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-ember-dark">{path.num}</span>
            <h3 class="mt-6 font-display text-4xl uppercase tracking-[0.055em] text-ink transition-colors group-hover:text-ember-dark">{path.title}</h3>
            <p class="mt-3 font-body text-sm leading-[1.75] text-stone">{path.description}</p>
            <span class="mt-7 inline-flex font-mono text-[9px] font-bold uppercase tracking-[0.13em] text-ink">
              {path.label} <span aria-hidden="true" class="ml-3 text-ember transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="texture-paper border-t border-ink/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-16 sm:px-6 md:flex-row md:items-center md:justify-between md:py-20 lg:px-8">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-ember-dark">Seasonal correspondence</p>
        <h2 class="mt-3 font-display text-5xl uppercase leading-none tracking-[0.05em] text-ink">Letters from the turning year</h2>
        <p class="mt-4 font-body text-base leading-relaxed text-stone">The meaning of each solstice and equinox—past, present, and future—with one mindful practice for the season ahead.</p>
      </div>
      <a href="/newsletter" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-md border border-ink/25 px-6 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-ink transition-colors hover:border-ember-dark hover:text-ember-dark">
        Read the letters
      </a>
    </div>
  </section>
</Layout>
