---
import Layout from "@/components/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Elders from "@/content/elders/index.mdx";
---

<Layout title="The Wise Elders — Earthsong" description="Archetypal voices of listening, courage, belonging, gentleness, and stewardship.">
  <PageHeader
    eyebrow="Archetypes · Teachings · Public telling"
    title="The Wise Elders"
    description="Mirrors for qualities we each carry—not owners of any culture, but listeners to the Earth. These open-handed teachings invite balance, humility, and care."
  />

  <article class="prose prose-lg mt-12 max-w-none prose-earthsong elders-prose">
    <Elders />
  </article>
</Layout>

<style>
  .elders-prose :global(h1) { display: none; }
  .elders-prose :global(h2) {
    margin-bottom: 0.65rem;
    padding-top: 2rem;
  }
  .elders-prose :global(h2 + p) {
    margin-top: 0;
  }
  .elders-prose :global(blockquote) {
    margin-top: 2.5rem;
    border-radius: 0.5rem;
    background: rgba(61, 92, 46, 0.07);
    padding: 1.5rem 1.5rem 1.5rem 2rem;
  }
</style>
